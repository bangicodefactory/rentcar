# Client branding comes from the Setting model (seeded per client).
# Change this only if you know what you're doing.
APP_NAME=rentcar
VITE_APP_NAME="${APP_NAME}"
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Active client for this deployment — do not change for local dev
APP_CLIENT=directonderweg

# Set to true once the Inertia/React SPA shell is in place (Phase 4+).
# Controls which controllers return Inertia::render() vs the legacy Blade view.
INERTIA_ENABLED=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rentcar
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — Mailpit (https://github.com/axllent/mailpit) listens on 127.0.0.1:1025 by default
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@directonderweg.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Stripe — use test-mode keys locally (pk_test_... / sk_test_...)
STRIPE_KEY=
STRIPE_SECRET=

# PayPal — sandbox only locally
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Live keys belong in the GitHub Environment for production — never commit them
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=

# Google reCAPTCHA v2 — use Google's always-pass test keys for local dev:
#   sitekey : 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   secret  : 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
NOCAPTCHA_SITEKEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
NOCAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Dev tools — enable locally, set to false (or omit) in production
# Run `php artisan telescope:migrate` once after enabling for the first time.
TELESCOPE_ENABLED=true
DEBUGBAR_ENABLED=true

# Sentry error monitoring — leave blank to disable locally.
# Set the real DSN in each GitHub Environment (production-directonderweg,
# staging-directonderweg). Never commit a real DSN here.
SENTRY_LARAVEL_DSN=
# Baked in at build/deploy time — identifies which commit produced the error.
SENTRY_RELEASE=
# Identifies which deployment environment the error came from.
# Use: local | staging-directonderweg | production-directonderweg
SENTRY_ENVIRONMENT=local
